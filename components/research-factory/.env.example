# Never commit real credentials. Model calls are OFF by default.
HRP_ALLOW_MODEL_CALLS=NO
# Provider available only when explicitly enabled: openai | ollama
HRP_MODEL_PROVIDER=openai
# For hosted calls only. Set locally via secure environment manager.
OPENAI_API_KEY=
# For local Ollama requests. Never expose Ollama to the public internet.
OLLAMA_HOST=http://127.0.0.1:11434
HRP_LOCAL_MODEL_ID=gemma4:e2b-it-q4_K_M
# Run manifests and optional Agno SQLite state stay local and untracked.
HRP_FACTORY_RUN_ROOT=./runs
